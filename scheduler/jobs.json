{
  "name": "TradingDailyScans",
  "description": "Jobs started by the 8 AM / first-logon Windows task. Disable any scanner you do not want in the daily pass.",
  "jobs": [
    {
      "name": "prefetch-yahoo-ohlcv",
      "note": "Downloads 2y of Nifty 500 Yahoo daily bars once into yahoo_ohlcv_daily. Every later cache-replay job must read that table and must not call yfinance again.",
      "enabled": true,
      "script": "prefetch_yahoo_ohlcv.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--lookback",
        "2y",
        "--request-delay",
        "0.1"
      ],
      "tracking": {
        "enabled": false,
        "role": "infrastructure"
      }
    },
    {
      "name": "bullish-bias-nifty500",
      "note": "Cache replay: get_daily_history reads today's prefetch. Live yfinance only if prefetch-yahoo-ohlcv has not run today.",
      "enabled": true,
      "script": "bullishbiasnifty500.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Bullish_Bias_Analysis.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "classification_column": "Status"
      }
    },
    {
      "name": "bearish-bias-nifty500",
      "enabled": true,
      "script": "bearisbiasnifty500.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Bearish_Momentum_Analysis.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "classification_column": "Setup Status"
      }
    },
    {
      "name": "nifty500-xy-intersect",
      "enabled": true,
      "script": "nifty500_xy_intersect.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/nifty500_xy_matrix_signals.csv",
        "--request-delay",
        "0.1"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "csv",
        "symbol_column": "Ticker",
        "classification_column": "X/Y Intersect Rule"
      }
    },
    {
      "name": "rangebound-stocks",
      "enabled": true,
      "script": "rangeboundstocks.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Strangle_Candidate_Analysis.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "classification_column": "Setup Status"
      }
    },
    {
      "name": "minervini-vcp",
      "enabled": true,
      "script": "minervini_vcp_scanner.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Minervini_VCP_Scan.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "membership_filter": "Qualified=True",
        "signal_date_column": "Date"
      }
    },
    {
      "name": "nimblr-minervini-cpr",
      "note": "Disabled from the daily pass to shorten the 8 AM / first-logon scan. Run nimblr_minervini_cpr_scanner.py manually when needed.",
      "enabled": false,
      "script": "nimblr_minervini_cpr_scanner.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Nimblr_Minervini_CPR_Scan.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "membership_filter": "Qualified=True",
        "signal_date_column": "Date"
      }
    },
    {
      "name": "minervini-volume-cpr",
      "enabled": true,
      "script": "minervini_volume_cpr_scanner.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Minervini_Volume_CPR_Scan.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "membership_filter": "Qualified=True",
        "signal_date_column": "Date"
      }
    },
    {
      "name": "nifty-fib-pinball-bullish",
      "enabled": true,
      "script": "nifty_pinball_yahoo.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Bullish_Fib_Pinball.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "sheet": "All",
        "symbol_column": "Ticker",
        "signal_date_column": "Last Date",
        "classification_column": "Wave Position",
        "confidence_column": "Confidence"
      }
    },
    {
      "name": "nifty-fib-pinball-bearish",
      "enabled": true,
      "script": "bearish_fib_pinball.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Bearish_Fib_Pinball.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "sheet": "All",
        "symbol_column": "Ticker",
        "signal_date_column": "Last Date",
        "classification_column": "Wave Position",
        "confidence_column": "Confidence"
      }
    },
    {
      "name": "merge-option-candidates",
      "enabled": true,
      "script": "merge_ticker_candidates.py",
      "args": [
        "--sources",
        "outputs/{date}/Bullish_Bias_Analysis.xlsx",
        "outputs/{date}/Bearish_Momentum_Analysis.xlsx",
        "outputs/{date}/Strangle_Candidate_Analysis.xlsx",
        "--output",
        "outputs/{date}/Option_Scan_Candidates.csv"
      ],
      "tracking": {
        "enabled": true,
        "role": "aggregator",
        "format": "csv",
        "symbol_column": "Ticker"
      }
    },
    {
      "name": "combined-option-v8",
      "note": "If your local copy of this scanner is named combinedoptionanalyzedv8v2.py, update 'script' below to match.",
      "enabled": true,
      "skip_if_empty_input": true,
      "script": "combinedoptionanalyzedv8.py",
      "args": [
        "--input",
        "outputs/{date}/Option_Scan_Candidates.csv",
        "--output",
        "outputs/{date}/Combined_Option_Spread_Analysis.xlsx",
        "--browser-impersonation",
        "--request-delay",
        "1.5",
        "--max-retries",
        "6"
      ],
      "tracking": {
        "enabled": true,
        "role": "downstream",
        "format": "xlsx",
        "sheet": "All Opportunities",
        "symbol_column": "Symbol",
        "classification_column": "Strategy",
        "confidence_column": "Score"
      }
    },
    {
      "name": "validate-2026-08-30-outputs",
      "note": "ONE-TIME: compare 30 Aug 2026 Excel files and SQLite/PostgreSQL scanner hits to the shared yahoo_ohlcv_daily cache. Disable after review.",
      "enabled": true,
      "script": "validate_daily_outputs.py",
      "args": [
        "--date",
        "2026-08-30",
        "--baseline",
        "outputs/2026-08-30",
        "--replay",
        "--output",
        "outputs/2026-08-30/Yahoo_Cache_Validation.xlsx"
      ],
      "tracking": {
        "enabled": false,
        "role": "infrastructure"
      }
    }
  ]
}
