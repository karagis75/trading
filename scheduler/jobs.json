{
  "name": "TradingDailyScans",
  "description": "Jobs started by the 8 AM / first-logon Windows task. Disable any scanner you do not want in the daily pass.",
  "jobs": [
    {
      "name": "bullish-bias-nifty500",
      "enabled": true,
      "script": "bullishbiasnifty500.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Bullish_Bias_Analysis.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "classification_column": "Status"
      }
    },
    {
      "name": "bearish-bias-nifty500",
      "enabled": true,
      "script": "bearisbiasnifty500.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Bearish_Momentum_Analysis.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "classification_column": "Setup Status"
      }
    },
    {
      "name": "nifty500-xy-intersect",
      "enabled": true,
      "script": "nifty500_xy_intersect.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/nifty500_xy_matrix_signals.csv",
        "--request-delay",
        "0.1"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "csv",
        "symbol_column": "Ticker",
        "classification_column": "X/Y Intersect Rule"
      }
    },
    {
      "name": "rangebound-stocks",
      "enabled": true,
      "script": "rangeboundstocks.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Strangle_Candidate_Analysis.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "classification_column": "Setup Status"
      }
    },
    {
      "name": "nimblr-minervini-cpr",
      "enabled": true,
      "script": "nimblr_minervini_cpr_scanner.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Nimblr_Minervini_CPR_Scan.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "symbol_column": "Ticker",
        "membership_filter": "Qualified=True",
        "signal_date_column": "Date"
      }
    },
    {
      "name": "nifty-fib-pinball-bullish",
      "enabled": true,
      "script": "nifty_pinball_yahoo.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Bullish_Fib_Pinball.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "sheet": "All",
        "symbol_column": "Ticker",
        "signal_date_column": "Last Date",
        "classification_column": "Wave Position",
        "confidence_column": "Confidence"
      }
    },
    {
      "name": "nifty-fib-pinball-bearish",
      "enabled": true,
      "script": "bearish_fib_pinball.py",
      "args": [
        "--input",
        "ind_nifty500list.csv",
        "--output",
        "outputs/{date}/Bearish_Fib_Pinball.xlsx"
      ],
      "tracking": {
        "enabled": true,
        "role": "primary_scanner",
        "format": "xlsx",
        "sheet": "All",
        "symbol_column": "Ticker",
        "signal_date_column": "Last Date",
        "classification_column": "Wave Position",
        "confidence_column": "Confidence"
      }
    },
    {
      "name": "merge-option-candidates",
      "enabled": true,
      "script": "merge_ticker_candidates.py",
      "args": [
        "--sources",
        "outputs/{date}/Bullish_Bias_Analysis.xlsx",
        "outputs/{date}/Bearish_Momentum_Analysis.xlsx",
        "outputs/{date}/Strangle_Candidate_Analysis.xlsx",
        "--output",
        "outputs/{date}/Option_Scan_Candidates.csv"
      ],
      "tracking": {
        "enabled": true,
        "role": "aggregator",
        "format": "csv",
        "symbol_column": "Ticker"
      }
    },
    {
      "name": "combined-option-v8",
      "note": "If your local copy of this scanner is named combinedoptionanalyzedv8v2.py, update 'script' below to match.",
      "enabled": true,
      "skip_if_empty_input": true,
      "script": "combinedoptionanalyzedv8.py",
      "args": [
        "--input",
        "outputs/{date}/Option_Scan_Candidates.csv",
        "--output",
        "outputs/{date}/Combined_Option_Spread_Analysis.xlsx",
        "--browser-impersonation",
        "--request-delay",
        "1.5",
        "--max-retries",
        "6"
      ],
      "tracking": {
        "enabled": true,
        "role": "downstream",
        "format": "xlsx",
        "sheet": "All Opportunities",
        "symbol_column": "Symbol",
        "classification_column": "Strategy",
        "confidence_column": "Score"
      }
    }
  ]
}
